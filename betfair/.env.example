# Copia a .env y rellena. NUNCA commitees el .env real (está en .gitignore).
# En GitHub Actions / VPS, estos van como Secrets, no como archivo.

# App Key de Betfair (la delayed key sirve para CAPTURAR datos; para apostar real
# necesitas la live key).
BETFAIR_APP_KEY=tu_app_key

# Credenciales de tu cuenta Betfair
BETFAIR_USERNAME=tu_usuario
BETFAIR_PASSWORD=tu_password

# Login no interactivo por certificado (recomendado para correr desatendido).
# Si los dejas vacíos, el cliente usa login interactivo (usuario+clave).
# BETFAIR_CERT_FILE=/ruta/client-2048.crt
# BETFAIR_KEY_FILE=/ruta/client-2048.key
